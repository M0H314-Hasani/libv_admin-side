{
	"compilerOptions": {
		"module": "esnext",
		"target": "esnext",
		"moduleResolution": "node",
		"types": [
			"vite/client"
		],
		"checkJs": true,
		"baseUrl": ".",
		"paths": {
			"@/*": [
				"./src/*"
			]
		},
		"resolveJsonModule": true
	},
	"include": [
		"src/**/*",
		"@types/**/*"
	],
	"exclude": [
		"src/assets/**/*"
	]
}